<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep cabinet gradient, matching the in-game "void" backdrop palette. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#11162E"
                android:centerColor="#0A0C1E"
                android:endColor="#03040C" />
        </aapt:attr>
    </path>

    <!-- Soft key-light pool, upper-left, echoing the table's lighting model. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:gradientRadius="86"
                android:centerX="30"
                android:centerY="24"
                android:startColor="#296F8CFF"
                android:endColor="#006F8CFF" />
        </aapt:attr>
    </path>

    <!-- Vignette toward the corners for depth. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:gradientRadius="80"
                android:centerX="54"
                android:centerY="58"
                android:startColor="#00000000"
                android:centerColor="#00000000"
                android:endColor="#80000000" />
        </aapt:attr>
    </path>
</vector>
